   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #0F1E36;
    font-family: "Segoe UI", Arial, sans-serif;
}

QFrame#card_container {
    background-color: #F8FAFC;
    border-radius: 12px;
    border: 1px solid #CBD5E1;
}

QLabel#lb {
    background-color: #0F1E36;
    color: #D4AF37;
    font-size: 20pt;
    font-weight: bold;
    border-radius: 8px;
    border-bottom: 3px solid #D4AF37;
    padding: 10px;
}

QLabel.field_label {
    color: #1E293B;
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1.5px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 11pt;
}

QLineEdit:focus {
    border: 1.5px solid #D4AF37;
    background-color: #FFFDF7;
}

QPushButton#att_bt {
    background-color: #D4AF37;
    color: #0F1E36;
    font-size: 11pt;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 24px;
    border: none;
}

QPushButton#att_bt:hover {
    background-color: #E2C044;
}

QPushButton#att_bt:pressed {
    background-color: #B89628;
}

QPushButton#voltar_bt {
    background-color: #E2E8F0;
    color: #334155;
    font-size: 11pt;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 20px;
    border: 1px solid #CBD5E1;
}

QPushButton#voltar_bt:hover {
    background-color: #CBD5E1;
    color: #0F172A;
}</string>
