  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #0F1E36;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Menu Lateral */
QFrame#sidebar {
    background-color: #162947;
    border-radius: 12px;
    border: 1px solid #233B63;
}

QLabel#brand_title {
    color: #D4AF37;
    font-size: 16pt;
    font-weight: bold;
    padding: 12px 8px;
    border-bottom: 1px solid #233B63;
}

QPushButton.nav_btn {
    background-color: transparent;
    color: #E2E8F0;
    font-size: 11pt;
    font-weight: bold;
    text-align: left;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid transparent;
}

QPushButton.nav_btn:hover {
    background-color: #1E365C;
    color: #FFFFFF;
    border: 1px solid #D4AF37;
}

QPushButton.nav_btn:pressed {
    background-color: #D4AF37;
    color: #0F1E36;
}

/* Container Principal */
QStackedWidget#hud {
    background-color: #F8FAFC;
    border-radius: 12px;
    border: 1px solid #CBD5E1;
}

QLabel.page_header {
    background-color: #0F1E36;
    color: #D4AF37;
    font-size: 18pt;
    font-weight: bold;
    border-radius: 8px;
    border-bottom: 3px solid #D4AF37;
    padding: 10px 16px;
}

QLabel.field_label {
    color: #1E293B;
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
}

/* Inputs */
QLineEdit, QTextEdit, QDateEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1.5px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 11pt;
}

QLineEdit:focus, QTextEdit:focus, QDateEdit:focus {
    border: 1.5px solid #D4AF37;
    background-color: #FFFDF7;
}

/* Tabelas */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    font-size: 10pt;
    selection-background-color: #FEF3C7;
    selection-color: #0F1E36;
}

QHeaderView::section {
    background-color: #0F1E36;
    color: #D4AF37;
    font-weight: bold;
    font-size: 10pt;
    padding: 8px;
    border: none;
    border-right: 1px solid #1E365C;
}

/* Botões de Ação */
QPushButton.primary_btn {
    background-color: #D4AF37;
    color: #0F1E36;
    font-size: 11pt;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 20px;
    border: none;
}

QPushButton.primary_btn:hover {
    background-color: #E2C044;
}

QPushButton.primary_btn:pressed {
    background-color: #B89628;
}

QPushButton.secondary_btn {
    background-color: #1E293B;
    color: #F8FAFC;
    font-size: 10pt;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 16px;
    border: none;
}

QPushButton.secondary_btn:hover {
    background-color: #334155;
}</string>
